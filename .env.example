# ─────────────────────────────────────────────────────────
# .env.example — TEMPLATE FILE
#
# How to use:
#   1. Copy this file to a new file named `.env`
#   2. Paste your actual keys after the = signs
#   3. Save. The .env file is gitignored — it will NEVER be committed.
#
# To run a script that needs these keys:
#   node --env-file=.env scripts/generate-narration.mjs
# ─────────────────────────────────────────────────────────

# REQUIRED for The Roadmap experience (Layer 1).
# Get a free key at https://console.groq.com (no credit card needed).
# Without this, dev mode will return a mock Roadmap response so the
# UI is testable, but the real AI won't be called.
GROQ_API_KEY=

# REQUIRED to generate the Hank narration MP3s for Brand Transmission.
# Run scripts/generate-narration.mjs once with this key set, commit
# the resulting public/audio/ files, and you're done — the key is
# only needed at MP3-generation time, not at runtime.
ELEVENLABS_API_KEY=

# OPTIONAL — only needed if you re-enable any Gemini-powered legacy
# components. The new Roadmap module does NOT need this.
GEMINI_API_KEY=
