{
  "name": "swrv-on-the-go",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && npm run build:portal",
    "build:portal": "cd portal && npm install && npm run build",
    "preview": "npm run build && wrangler dev",
    "lint": "tsc --noEmit",
    "deploy": "npm run build && wrangler deploy",
    "sync-theme": "node scripts/sync-theme.js",
    "prebuild": "node scripts/sync-theme.js"
  },
  "dependencies": {
    "@google/genai": "^1.40.0",
    "@supabase/supabase-js": "^2.108.2",
    "@tailwindcss/vite": "^4.2.1",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.563.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.3",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wrangler": "^4.90.0"
  }
}
